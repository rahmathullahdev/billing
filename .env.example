# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Public Sanity identifiers (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only Sanity token with the minimum required permissions (write access to this dataset).
# Do NOT prefix with NEXT_PUBLIC_.
SANITY_API_TOKEN=your_sanity_api_token

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
